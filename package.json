{
  "name": "react-kronos-public",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/storefront dev",
    "build": "pnpm --dir apps/storefront build",
    "build:dev": "pnpm --dir apps/storefront build:dev",
    "build:uat": "pnpm --dir apps/storefront build:uat",
    "build:prod": "pnpm --dir apps/storefront build:prod",
    "lint": "pnpm --dir apps/storefront lint",
    "preview": "pnpm --dir apps/storefront preview",
    "check:safety": "node scripts/check-storefront-boundary.mjs",
    "deploy:uat": "pnpm --dir apps/storefront build:uat && firebase deploy --project uat --only hosting:storefront",
    "deploy:prod": "pnpm --dir apps/storefront build:prod && firebase deploy --project prod --only hosting:storefront"
  },
  "devDependencies": {
    "firebase-tools": "^15.10.0"
  }
}
